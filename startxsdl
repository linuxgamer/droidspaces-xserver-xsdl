#!/usr/bin/bash

export DISPLAY=127.0.0.1:0
export PULSE_SERVER=tcp:127.0.0.1:4713
# some DE parts expect it even over plain X11; set if missing (su sessions)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# --- wait for the XSDL xserver (container may boot before u open the app) ---
DISPLAY_NUM="${DISPLAY##*:}"; DISPLAY_NUM="${DISPLAY_NUM%%.*}"
XPORT="$((6000 + DISPLAY_NUM))"
echo "waiting for XSDL xserver on 127.0.0.1:${XPORT}..."
UP=0
for _ in $(seq 1 30); do
    if (exec 3<>"/dev/tcp/127.0.0.1/$XPORT") 2>/dev/null; then
        UP=1
        break
    fi
    sleep 1
done
if [ "$UP" = 0 ]; then
    echo "ERROR: XSDL not reachable — is the app running?"
    echo "start it on ur phone and retry (the service will also retry on its own)"
    exit 1
fi

# supported DEs, in autodetect priority order (xfce first = droidspaces default)
declare -A DESKS=(
    [xfce]="startxfce4"
    [kde]="startplasma-x11"
    [mate]="mate-session"
    [cinnamon]="cinnamon-session"
    [lxqt]="startlxqt"
    [lxde]="startlxde"
    [gnome]="gnome-session"
    [budgie]="budgie-desktop"
)
ORDER="xfce kde mate cinnamon lxqt lxde gnome budgie"

# de can be forced: startxsdl kde
DE="${1:-}"
CMD=""

if [ -n "$DE" ]; then
    CMD="${DESKS[$DE]}"
    if [ -z "$CMD" ]; then
        echo "unknown de '$DE', supported: ${ORDER}"
        exit 1
    fi
    if ! command -v "$CMD" >/dev/null; then
        echo "de '$DE' selected but '$CMD' is not installed"
        exit 1
    fi
else
    for name in $ORDER; do
        if command -v "${DESKS[$name]}" >/dev/null; then
            DE="$name"
            CMD="${DESKS[$name]}"
            break
        fi
    done
fi

if [ -z "$CMD" ]; then
    echo "ERROR: no supported DE found"
    echo "install one of: ${ORDER}"
    exit 1
fi

echo "starting $DE ($CMD) on XSDL..."
exec "$CMD"
